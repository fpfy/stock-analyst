# 数据库配置
DB_PATH=database/stock_analysis.db

# Tushare API配置
TUSHARE_TOKEN=your_token_here

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=logs/stock_analysis.log

# 性能配置
ENABLE_CACHE=true
CACHE_TTL=300
MAX_WORKERS=4

# 监控配置
ENABLE_MONITORING=true
HEALTH_CHECK_INTERVAL=30

# 通知配置
ENABLE_ALERTS=true
ALERT_EMAIL=your_email@example.com
ALERT_WECHAT=your_wechat_id
